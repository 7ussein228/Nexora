# ============================================================
# NEXORA - environment template
#
# Copy to .env.local (or run setup-env.bat on Windows) and fill in.
# Everything here is SERVER-SIDE ONLY.
#
# Do NOT prefix any of these with VITE_. Vite inlines VITE_*
# variables into the client bundle, which would publish your
# secrets to every visitor.
# ============================================================

# ---------- Paymob (cards + local methods) ----------
# Dashboard > Settings > Account Info > API Key
PAYMOB_API_KEY=
# Dashboard > Developers > Payment Integrations
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
# Used to verify webhook callbacks are genuinely from Paymob
PAYMOB_HMAC_SECRET=

# ---------- Vodafone Cash (wallet) ----------
VODAFONE_CASH_MERCHANT_ID=
VODAFONE_CASH_API_KEY=
VODAFONE_CASH_WALLET_INTEGRATION_ID=

# ---------- Core ----------
DATABASE_URL=postgres://user:password@localhost:5432/nexora
# Random 32+ byte string. setup-env.bat generates one automatically.
SESSION_SECRET=

# ---------- Email ----------
SMTP_HOST=
SMTP_USER=
SMTP_PASS=

# ---------- Optional integrations ----------
WHATSAPP_API_TOKEN=
OPENAI_API_KEY=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ---------- Public (safe to expose) ----------
# Only values that are genuinely public belong behind VITE_.
VITE_SITE_URL=https://nexora.example
VITE_DEFAULT_LANG=en
